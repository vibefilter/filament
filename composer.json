{
    "name": "vibefilter/filament",
    "description": "Filter Filament tables with a plain-English statement. Each row is scored by TypeSafe Jev.",
    "keywords": [
        "filament",
        "filamentphp",
        "filament-plugin",
        "laravel",
        "ai",
        "zero-shot",
        "classification",
        "natural-language",
        "filter",
        "jev",
        "jev-ai",
        "jev-api",
        "typesafe",
        "openrouter"
    ],
    "homepage": "https://vibefilter.dev",
    "support": {
        "issues": "https://github.com/vibefilter/filament/issues",
        "source": "https://github.com/vibefilter/filament"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "András Horváth",
            "email": "vibefilter@andrashorvath.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.9",
        "illuminate/http": "^12.36|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Vibefilter\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vibefilter\\Filament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "test:lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vibefilter\\Filament\\VibefilterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
